{
  "id": "js_secret_precision_001",
  "description": "JS-derived endpoint should rank while a static asset remains suppressed.",
  "observations": [
    {
      "kind": "endpoint",
      "subject": "https://example.test/api/v1/account/export?redirect=https://other.test",
      "source": "javascript",
      "attributes": {
        "method": "GET",
        "features": {
          "is_api": true,
          "has_sensitive_parameter": true,
          "is_account_or_team": true
        }
      }
    },
    {
      "kind": "endpoint",
      "subject": "https://example.test/static/app.12345678.js",
      "source": "javascript",
      "attributes": {
        "method": "GET",
        "features": {}
      }
    }
  ],
  "expected_queue": [
    "https://example.test/api/v1/account/export?redirect=https://other.test"
  ],
  "expected_suppressed": [
    "https://example.test/static/app.12345678.js"
  ]
}
